{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Scenario Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "run_id", "source", "scenarios"],
  "properties": {
    "manifest_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["chat", "markdown", "json"] },
        "path": { "type": "string" },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feature", "title", "objective", "steps", "expected", "risk", "capabilities", "proof_layers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
        "feature": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "actors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "expected": { "type": "string", "minLength": 1 }
            }
          }
        },
        "expected": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "test_data": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "cleanup": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^@[A-Za-z0-9_-]+$" }, "uniqueItems": true },
        "derived_from": { "type": ["string", "null"] },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impact", "likelihood", "score", "priority"],
          "properties": {
            "impact": { "type": "integer", "minimum": 1, "maximum": 3 },
            "likelihood": { "type": "integer", "minimum": 1, "maximum": 3 },
            "score": { "type": "integer", "minimum": 1, "maximum": 9 },
            "priority": { "enum": ["critical", "high", "normal", "low"] }
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "api", "e2e", "component", "visual", "accessibility", "mobile", "i18n",
              "files", "multi-context", "frames", "clock", "network", "realtime", "offline",
              "canvas", "electron", "extension", "webmcp", "multi-user", "migration", "ci",
              "coverage", "security", "performance"
            ]
          }
        },
        "proof_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["api", "e2e", "component", "visual", "accessibility", "static", "manual"] }
        },
        "status": { "enum": ["planned", "generated", "passed", "product-defect", "blocked"] }
      }
    }
  }
}
